#!/usr/bin/env bash
# Termica pre-commit hook.
#
# Runs fmt + clippy + the markdown hard-wrap lint locally so style
# regressions can't slip into a commit. Does NOT run the general
# `cargo test` suite: the project follows a tests-first discipline
# (CLAUDE.md), which means a failing behavioural test is expected to be
# committed BEFORE the implementation that makes it pass. CI runs the
# full suite and gates merge — that's where test failures block the
# world. The markdown lint is the one exception: it is a deterministic
# lint (never committed red-first), so it belongs here with fmt/clippy.
#
# Install with:
#
#     scripts/install-git-hooks.sh
#
# Skip once, deliberately (rare): git commit --no-verify
# CLAUDE.md's commit protocol forbids routine --no-verify use.

set -euo pipefail

# Colors, but only on a TTY.
if [[ -t 1 ]]; then
    BOLD=$'\033[1m'
    RED=$'\033[31m'
    GREEN=$'\033[32m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
else
    BOLD="" RED="" GREEN="" DIM="" RESET=""
fi

step() {
    printf "%spre-commit:%s %s\n" "${BOLD}" "${RESET}" "$1"
}

fail() {
    printf "%spre-commit failed:%s %s\n" "${RED}${BOLD}" "${RESET}" "$1" >&2
    printf "%sto bypass (discouraged): git commit --no-verify%s\n" "${DIM}" "${RESET}" >&2
    exit 1
}

# Only check when there is something staged; empty commits still call
# the hook but there is nothing to check.
if git diff --cached --quiet; then
    step "no staged changes; skipping"
    exit 0
fi

step "cargo fmt --all -- --check"
cargo fmt --all -- --check || fail "formatting issues; run: cargo fmt --all"

step "cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings || fail "clippy warnings"

# The markdown-wrap check is a deterministic *lint*, not a behavioural
# test — it is never committed red-first — so it belongs here alongside
# fmt/clippy rather than in CI-only territory. `clippy --all-targets`
# above already compiled this test target, so the marginal cost is small.
step "cargo test --test markdown_no_hardwrap (markdown hard-wrap lint)"
cargo test --test markdown_no_hardwrap --quiet \
    || fail "markdown is hard-wrapped; one line per paragraph (see failures above)"

printf "%spre-commit passed%s %s(behavioural tests are CI's job; see scripts/git-hooks/pre-commit header)%s\n" \
    "${GREEN}" "${RESET}" "${DIM}" "${RESET}"
